{
  "name": "@tetherto/mdk-app-runtime",
  "version": "0.13.0",
  "description": "MDK app runtime: runs one app's controllers in its own process and serves them over HRPC",
  "main": "index.js",
  "bin": {
    "mdk-app-runtime": "bin/run-app.js"
  },
  "keywords": [
    "tether",
    "mdk",
    "app"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "NODE_ENV=test brittle tests/unit/*.test.js",
    "test:coverage": "NODE_ENV=test brittle --coverage 'tests/**/*.test.js'"
  },
  "dependencies": {
    "@hyperswarm/rpc": "^3.5.0",
    "@tetherto/mdk-client": "^0.13.0",
    "@tetherto/mdk-rbac": "^0.13.0",
    "@tetherto/mdk-worker": "^0.13.0",
    "debug": "4.4.1",
    "hyperdht": "6.34.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "brittle": "3.18.0",
    "standard": "17.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/mdk.git",
    "directory": "backend/core/app-runtime"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "lib/",
    "bin/",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./lib/plugin-loader": "./lib/plugin-loader.js",
    "./bin/run-app.js": "./bin/run-app.js",
    "./package.json": "./package.json"
  }
}

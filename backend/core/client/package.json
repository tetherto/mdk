    "debug": "^4.4.1",
    "hyperdht": "6.34.1"
  },
  "devDependencies": {
    "brittle": "3.18.0",
    "standard": "17.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/mdk.git",
    "directory": "backend/core/client"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "lib/",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  }

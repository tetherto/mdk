{
  "name": "@tetherto/mdk-client",
  "version": "0.13.0",
  "description": "MDK protocol client — HRPC (RPC listener) transport for Kernel",
  "main": "index.js",
  "keywords": [
    "tether",
    "mdk",
    "client"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "NODE_ENV=test brittle tests/unit/*.js",
    "test:coverage": "NODE_ENV=test brittle --coverage 'tests/**/*.test.js'"
  },
  "dependencies": {
    "@tetherto/mdk-identity": "^0.13.0",
    "@tetherto/mdk-kernel": "^0.13.0",

{
  "name": "@tetherto/mdk-gateway",
  "version": "0.13.0",
  "description": "MDK Gateway",
  "keywords": [
    "tether"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./plugin": "./plugin.js",
    "./workers/lib/plugin-loader": "./workers/lib/plugin-loader.js",
    "./workers/lib/plugin-adapter": "./workers/lib/plugin-adapter.js",
    "./workers/lib/plugin-gateway": "./workers/lib/plugin-gateway.js",
    "./workers/lib/authority": "./workers/lib/authority.js",
    "./workers/http.node.wrk": "./workers/http.node.wrk.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "npm run lint && npm run test:unit && npm run test:integration",
    "test:unit": "NODE_ENV=test brittle tests/unit/**/*.test.js",
    "test:integration": "NODE_ENV=test npx brittle tests/integration/*.test.js",
    "test:api": "NODE_ENV=test npx brittle tests/integration/api.test.js",
    "test:watch": "brittle tests/unit/**/*.js --watch",
    "test:coverage": "NODE_ENV=test brittle --coverage 'tests/**/*.test.js'",
    "dev": "node worker.js --wtype wrk-node-http --env development --port 3000",
    "start": "node worker.js --wtype wrk-node-http --env production --port 3000"
  },
  "dependencies": {
    "@bitfinex/bfx-svc-boot-js": "1.2.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@tetherto/mdk-app-runtime": "^0.13.0",
    "@tetherto/mdk-identity": "^0.13.0",
    "@tetherto/mdk-rbac": "^0.13.0",
    "@tetherto/svc-facs-httpd": "^2.0.2",
    "@tetherto/tether-wrk-base": "^2.0.0",
    "async": "3.2.6",
    "debug": "4.4.1",
    "lru": "3.1.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.2"
  },
  "devDependencies": {
    "@tetherto/mdk-core": "^0.13.0",
    "@tetherto/tether-svc-test-helper": "^1.0.0",
    "brittle": "3.18.0",
    "http-server": "14.1.1",
    "hyperdht": "6.34.1",
    "standard": "17.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/mdk.git",
    "directory": "backend/core/gateway"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "worker.js",
    "plugin.js",
    "workers/",
    "config/**/*.example",
    "README.md"
  ]
}

{
  "name": "@tetherto/mdk-echo-app",
  "version": "0.1.0",
  "routes": [
    { "id": "echo", "method": "POST", "path": "/echo", "handler": "controllers/echo.js" },
    { "id": "whoami", "method": "GET", "path": "/whoami", "handler": "controllers/misc.js#whoami" },
    { "id": "whoami-auth", "method": "GET", "path": "/whoami-auth", "auth": true, "handler": "controllers/misc.js#whoami" },
    { "id": "named", "method": "GET", "path": "/named/:id", "verb": "get", "resourceName": { "param": "id" }, "handler": "controllers/misc.js#whoami" },
    { "id": "counter", "method": "GET", "path": "/counter", "cache": ["query.k"], "handler": "controllers/misc.js#counter" },
    { "id": "counter-auth", "method": "GET", "path": "/counter-auth", "auth": true, "cache": ["query.k"], "handler": "controllers/misc.js#counter" },
    { "id": "config", "method": "GET", "path": "/config", "handler": "controllers/misc.js#config" },
    { "id": "slow", "method": "GET", "path": "/slow", "handler": "controllers/misc.js#slow" },
    { "id": "fail-safe", "method": "GET", "path": "/fail-safe", "handler": "controllers/misc.js#failSafe" },
    { "id": "fail-masked", "method": "GET", "path": "/fail-masked", "handler": "controllers/misc.js#failMasked" },
    { "id": "fail-masked-503", "method": "GET", "path": "/fail-masked-503", "handler": "controllers/misc.js#failMasked503" },
    { "id": "stream", "method": "GET", "path": "/stream", "stream": true, "handler": "controllers/stream.js#chunks" },
    { "id": "stream-fail", "method": "GET", "path": "/stream-fail", "stream": true, "handler": "controllers/stream.js#fail" },
    { "id": "stream-fail-mid", "method": "GET", "path": "/stream-fail-mid", "stream": true, "handler": "controllers/stream.js#failMid" }
  ]
}

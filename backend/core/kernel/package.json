    "debug": "^4.4.1",
    "hyperdht": "6.34.1",
    "hyperswarm": "^4.17.0",
    "mingo": "^6.4.15"
  },
  "devDependencies": {
    "brittle": "3.18.0",
    "standard": "17.1.0"
  },
  "repository": {

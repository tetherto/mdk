  "description": "MDK MCP Server",
  "main": "server.js",
  "keywords": [
    "tether"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "npm run lint && npm run test:unit && npm run test:integration",
    "test:unit": "NODE_ENV=test brittle tests/unit/*.test.js",
    "test:integration": "NODE_ENV=test brittle tests/integration/*.test.js",
    "test:coverage": "NODE_ENV=test brittle --coverage 'tests/**/*.test.js'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tetherto/mdk-app-runtime": "^0.13.0",
    "@tetherto/mdk-client": "^0.13.0",
    "@tetherto/mdk-rbac": "^0.13.0",
    "@tetherto/mdk-gateway": "^0.13.0",
    "@tetherto/mdk-worker": "^0.13.0",
    "async": "3.2.6",
    "debug": "4.4.1",
    "zod": "^4.0.0",
    "hono": "^4.12.34",
    "@hono/node-server": "^2.0.12"
  },
  "devDependencies": {
    "brittle": "3.18.0",
    "hyperdht": "6.34.1",
    "standard": "17.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/mdk.git",
    "directory": "backend/core/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "server.js",
    "plugin.js",
    "lib/",
    "README.md"
  ],
  "exports": {
    ".": "./server.js",
    "./plugin": "./plugin.js",
    "./package.json": "./package.json"
  }
}

{
  "name": "@tetherto/mdk-core",
  "version": "0.13.0",
  "description": "MDK bootstrap utilities and worker-infra services — kernel/gateway lifecycle plus injectable log/comment/alert/stats/settings/provisioning services for runtime-hosted workers",
  "main": "index.js",
  "keywords": [
    "tether",
    "mdk"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "npm run lint && npm run test:unit && npm run test:integration",
    "test:unit": "NODE_ENV=test brittle tests/unit/**/*.js",
    "test:integration": "NODE_ENV=test brittle 'tests/integration/**/*.test.js'",
    "test:coverage": "NODE_ENV=test brittle --coverage 'tests/**/*.test.js'"
  },
  "dependencies": {
    "@bitfinex/bfx-facs-http": "^1.1.3",
    "@bitfinex/lib-js-util-base": "^2.1.0",
    "@bitfinex/lib-js-util-promise": "^1.1.0",
    "@tetherto/hp-svc-facs-store": "^1.0.0",
    "@tetherto/mdk-client": "^0.13.0",
    "@tetherto/mdk-gateway": "^0.13.0",
    "@tetherto/mdk-kernel": "^0.13.0",
    "@tetherto/svc-facs-action-approver": "^1.0.0",
    "async": "3.2.6",
    "cron-parser": "5.10.2",
    "debug": "4.4.1",
    "hyperdht": "6.34.1",
    "mingo": "6.5.6",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "brittle": "3.18.0",
    "standard": "17.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/mdk.git",
    "directory": "backend/core/mdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "services.js",
    "worker.js",
    "lib/",
    "utils/",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./lib/dht-bootstrap": "./lib/dht-bootstrap.js",
    "./lib/local-discovery": "./lib/local-discovery.js",
    "./lib/worker-infra": "./lib/worker-infra.js",
    "./lib/services/pool-utils/time": "./lib/services/pool-utils/time.js",
    "./lib/services/pool-utils/constants": "./lib/services/pool-utils/constants.js",
    "./package.json": "./package.json"
  }
}

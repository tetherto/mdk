{
  "name": "@tetherto/mdk-plugin-demo",
  "version": "0.1.0",
  "description": "Aggregates live telemetry and SQLite history from @tetherto/mdk-worker-demo devices via the MDK protocol client.",
  "routes": [
    {
      "id": "demo.summary",
      "handler": "./controllers/summary.js",
      "auth": false,
      "http": {
        "method": "GET",
        "path": "/api/demo/summary",
        "responses": {
          "200": {
            "description": "Fleet totals and per-device metrics for demo-worker devices.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "kernelConnected": { "type": "boolean" },
                    "ts": { "type": "integer" },
                    "deviceCount": { "type": "integer" },
                    "totals": {
                      "type": "object",
                      "properties": {
                        "hashrateThs": { "type": "number" },
                        "powerW": { "type": "number" },
                        "avgTemperatureC": { "type": ["number", "null"] }
                      }
                    },
                    "devices": { "type": "array" }
                  }
                }
              }
            }
          }
        }
      },
      "description": "Fans out metrics telemetry to every registered demo-worker device (fingerprint: `hashrate_rt` + history) and returns fleet totals plus a per-device breakdown. Aggregation lives here — workers only ever answer for one device.",
      "constraints": [
        "Requires the MDK client to be connected to a Kernel instance for live data.",
        "Devices must expose demo-worker telemetry channels (hashrate_rt, power, temperature, power_mode, history)."
      ],
      "examples": [
        {
          "description": "Get current demo fleet totals",
          "request": "GET /api/demo/summary",
          "response": {
            "ok": true,
            "kernelConnected": true,
            "deviceCount": 2,
            "totals": { "hashrateThs": 240, "powerW": 6200, "avgTemperatureC": 65 },
            "devices": [
              {
                "deviceId": "demo-a-0",
                "workerId": "demo-a",
                "hashrateThs": 100,
                "powerW": 3000,
                "temperatureC": 64,
                "powerMode": "normal"
              }
            ]
          }
        }
      ],
      "errors": ["ERR_MDK_CLIENT_UNAVAILABLE"],
      "safety": "read-only"
    },
    {
      "id": "demo.history",
      "handler": "./controllers/history.js",
      "auth": false,
      "http": {
        "method": "GET",
        "path": "/api/demo/history",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 500, "default": 10 }
          },
          {
            "in": "query",
            "name": "deviceId",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent telemetry samples from each demo-worker's SQLite history channel.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "kernelConnected": { "type": "boolean" },
                    "limit": { "type": "integer" },
                    "deviceCount": { "type": "integer" },
                    "devices": { "type": "array" }
                  }
                }
              }
            }
          }
        }
      },
      "description": "Pulls the demo-worker `history` telemetry channel (SQLite recent samples: ts, `hashrate_ths`, `power_w`, `board_temp_c`) for every matched device, or a single device when `deviceId` is set.",
      "constraints": [
        "limit defaults to 10 and is capped at 500.",
        "Samples come from the worker's own store — the device is not contacted for this channel."
      ],
      "examples": [
        {
          "description": "Last 5 samples for every demo device",
          "request": "GET /api/demo/history?limit=5",
          "response": {
            "ok": true,
            "kernelConnected": true,
            "limit": 5,
            "deviceCount": 1,
            "devices": [
              {
                "deviceId": "demo-a-0",
                "workerId": "demo-a",
                "samples": [
                  { "ts": 1710000000000, "hashrate_ths": 100, "power_w": 3000, "board_temp_c": 64 }
                ]
              }
            ]
          }
        }
      ],
      "errors": ["ERR_MDK_CLIENT_UNAVAILABLE", "ERR_UNKNOWN_DEVICE_ID"],
      "safety": "read-only"
    }
  ]
}

{
  "name": "@tetherto/mdk-benchmark",
  "version": "0.13.0",
  "description": "Capacity/metrics benchmark harness for MDK — see docs/guides/deployment/capacity-metrics-template.md",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {

{
  "name": "@tetherto/mdk-worker-schneider",
  "version": "0.10.0",
  "description": "PowerMeter Schneider",
  "keywords": [
    "tether"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "engine": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "mock": "node mock/server.js --type",
    "test": "npm run lint && npm run test:unit && npm run test:integration",
    "test:unit": "brittle tests/unit/*.js",
    "test:integration": "brittle tests/integration/*.js",
    "test:coverage": "NODE_ENV=test brittle --coverage 'tests/**/*.test.js'"
  },
  "dependencies": {
    "@bitfinex/lib-js-util-promise": "^1.1.0",
    "@tetherto/svc-facs-modbus": "^0.1.1"
  },
  "devDependencies": {
    "brittle": "3.16.3",
    "debug": "4.4.1",
    "standard": "17.1.2",
    "modbus-stream": "0.46.0",
    "yargs": "17.7.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "serialport": "npm:noop@1.0.0"
  }
}

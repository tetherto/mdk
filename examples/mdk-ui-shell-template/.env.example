# Base URL of the Gateway backend for AUTHENTICATED data calls (/auth/*,
# /api/*). Leave EMPTY in development — Vite's dev server proxies `/auth`,
# `/api` etc. to the backend on :3000, so calls stay same-origin and dodge
# CORS. In production, set this only if your FE is on a different origin than
# the API; otherwise rely on the same-origin reverse proxy and keep it empty.
#
# Named `VITE_MDK_*` so it cannot collide with your app's own API URL. The
# old `VITE_API_BASE_URL` is still read for one major, with a warning.
VITE_MDK_API_URL=

# Gateway URL the Vite dev server proxies /auth, /oauth, /api and /pub to.
# `mdk create dashboard` sets this from your stack's mdk.yaml gateway port.
# Defaults to the mvp-site gateway (:3000) when unset.
VITE_GATEWAY_URL=http://localhost:3000

# Base URL of the OAuth backend. This MUST be absolute, because the sign-in
# button issues a full-page navigation (not an XHR) — the proxy doesn't help
# for top-level navigations. For local dev, the Gateway serves both /auth
# and /oauth on :3000.
VITE_OAUTH_BASE_URL=http://localhost:3000

# How users sign in: `password` for an MDK stack's Gateway (user name and
# password through the Kernel's token issuer; `mdk user add` creates users), or
# `oauth` for the mining Gateway's Google redirect (the default when unset).
# `mdk create dashboard` sets `password`.
VITE_AUTH_MODE=oauth

# DEV-ONLY auth bypass. `true` skips the /signin gate and lands straight on the
# dashboard with a stub session (no OAuth backend needed) and disables
# token-refresh polling. Set to `false` (or delete) once auth is wired up.
# NEVER enable in production.
VITE_AUTH_BYPASS=true

{
  "root": ".site-data",
  "host": "127.0.0.1",
  "discovery": "local",
  "worker": {
    "id": "whatsminer-m56s-telemetry-flow",
    "model": "m56s",
    "allowDuplicateIPs": true,
    "pools": [
      { "url": "stratum+tcp://btc.example-pool.com:3333", "worker_name": "account.worker", "worker_password": "x" }
    ],
    "thing": {
      "collectSnapsItvMs": 30000,
      "storeSnapItvMs": 30000
    }
  },
  "mocks": {
    "type": "m56s",
    "portBase": 14031,
    "defaultPassword": "admin"
  },
  "antminer": {
    "worker": {
      "id": "antminer-s21-telemetry-flow",
      "type": "miner-am-s21"
    },
    "mocks": {
      "portBase": 16080,
      "defaultPassword": "admin"
    }
  },
  "sealminer": {
    "worker": {
      "id": "sealminer-a2-telemetry-flow",
      "series": "A2"
    },
    "mocks": {
      "portBase": 17028,
      "firmware": "2026060901"
    }
  },
  "ocean": {
    "worker": {
      "id": "ocean-pool-worker"
    },
    "pool": {
      "apiUrl": "http://127.0.0.1:8010",
      "accounts": ["sample-ocean-account"],
      "apiRetry": 1
    },
    "mock": {
      "port": 8010
    }
  },
  "emcd": {
    "worker": {
      "id": "emcd-pool-worker",
      "rack": "site-1",
      "tickMs": 10000
    },
    "pool": {
      "apiUrl": "http://127.0.0.1:5065/pool/v1",
      "accounts": []
    },
    "mock": {
      "port": 5065
    }
  },
  "spiderpool": {
    "worker": {
      "id": "spiderpool-pool-worker",
      "rack": "site-1",
      "tickMs": 10000
    },
    "pool": {
      "apiUrl": "http://127.0.0.1:5066",
      "accounts": ["spider-test"]
    },
    "mock": {
      "port": 5066
    }
  },
  "foundry": {
    "worker": {
      "id": "foundry-pool-worker",
      "rack": "site-1",
      "tickMs": 10000
    },
    "pool": {
      "apiUrl": "http://127.0.0.1:5067",
      "accounts": ["test"]
    },
    "mock": {
      "port": 5067
    }
  },
  "satec": {
    "worker": {
      "id": "satec-powermeter-worker",
      "model": "pm180",
      "allowDuplicateIPs": true,
      "thing": {
        "collectSnapsItvMs": 5000,
        "storeSnapItvMs": 5000,
        "collectSnapTimeoutMs": 15000,
        "logKeepCount": 5
      }
    },
    "mocks": {
      "portBase": 15020
    }
  },
  "gateway": {
    "port": 3000,
    "host": "0.0.0.0",
    "allowedHosts": [],
    "pluginDirs": ["backend/gateway-plugins/site"],
    "staticRootPath": "ui/dist"
  },
  "mcp": {
    "agentTools": {
      "port": 3101,
      "pluginDirs": ["backend/mcp-plugins/site"]
    }
  },
  "rbac": {
    "password": "mdk-site-demo",
    "users": [
      { "name": "admin", "email": "admin@example.com", "groups": ["site-admins"] },
      { "name": "operator", "email": "operator@example.com", "groups": ["operators"] },
      { "name": "tech-whatsminer", "email": "tech@example.com", "groups": ["field-techs"] },
      { "name": "pool-manager", "email": "pools@example.com", "groups": [] },
      { "name": "auditor", "email": "audit@example.com", "groups": ["auditors"] },
      { "name": "viewer", "email": "viewer@example.com", "groups": ["viewers"] },
      { "name": "tenant-antminer", "email": "tenant@example.com", "groups": ["hosting-clients"] }
    ],
    "roles": [
      {
        "name": "site-admin",
        "rules": [
          { "resources": ["site/*"], "verbs": ["*"] },
          { "resources": ["workers"], "verbs": ["list", "read"] },
          { "resources": ["devices"], "verbs": ["read", "write"] },
          { "resources": ["commands"], "verbs": ["read"] }
        ]
      },
      {
        "name": "site-viewer",
        "rules": [
          { "resources": ["site/site/overview", "site/site/history", "site/site/access"], "verbs": ["get"] },
          { "resources": ["workers"], "verbs": ["list"] },
          { "resources": ["devices"], "verbs": ["read"] }
        ]
      },
      {
        "name": "power-control",
        "rules": [
          { "resources": ["site/site/miners/*/command"], "verbs": ["create"] },
          { "resources": ["devices"], "verbs": ["write"], "resourceNames": ["miner/*"] }
        ]
      },
      {
        "name": "pool-control",
        "rules": [
          { "resources": ["site/site/miners/*/pools"], "verbs": ["create"] },
          { "resources": ["devices"], "verbs": ["write"], "resourceNames": ["miner/*"] }
        ]
      },
      {
        "name": "whatsminer-tech",
        "rules": [
          { "resources": ["site/site/miners/*/command"], "verbs": ["create"] },
          { "resources": ["devices"], "verbs": ["write"], "resourceNames": ["miner/whatsminer/*"] }
        ]
      },
      {
        "name": "auditor",
        "rules": [
          { "resources": ["site/site/activity"], "verbs": ["get"] },
          { "resources": ["commands"], "verbs": ["read"] }
        ]
      },
      {
        "name": "antminer-tenant",
        "rules": [
          { "resources": ["site/site/overview", "site/site/history", "site/site/access"], "verbs": ["get"] },
          { "resources": ["site/site/miners/*/command"], "verbs": ["create"] },
          { "resources": ["workers"], "verbs": ["list"] },
          { "resources": ["devices"], "verbs": ["read", "write"], "resourceNames": ["miner/antminer/*"] }
        ]
      }
    ],
    "bindings": [
      { "role": "site-admin", "subjects": [{ "kind": "Group", "name": "site-admins" }] },
      {
        "role": "site-viewer",
        "subjects": [
          { "kind": "Group", "name": "operators" },
          { "kind": "Group", "name": "field-techs" },
          { "kind": "Group", "name": "auditors" },
          { "kind": "Group", "name": "viewers" },
          { "kind": "User", "name": "pool-manager" }
        ]
      },
      { "role": "power-control", "subjects": [{ "kind": "Group", "name": "operators" }] },
      {
        "role": "pool-control",
        "subjects": [
          { "kind": "Group", "name": "operators" },
          { "kind": "User", "name": "pool-manager" }
        ]
      },
      { "role": "whatsminer-tech", "subjects": [{ "kind": "Group", "name": "field-techs" }] },
      { "role": "auditor", "subjects": [{ "kind": "Group", "name": "auditors" }] },
      { "role": "antminer-tenant", "subjects": [{ "kind": "Group", "name": "hosting-clients" }] }
    ]
  },
  "pm2": {
    "script": "deploy/run-process.js",
    "exec_mode": "fork",
    "instances": 1,
    "autorestart": true,
    "restart_delay": 2000,
    "roles": ["mocks", "mocks-antminer", "mocks-sealminer", "mocks-ocean", "mocks-satec", "mocks-emcd", "mocks-spiderpool", "mocks-foundry", "kernel", "worker", "worker-antminer", "worker-sealminer", "worker-ocean", "worker-satec", "worker-emcd", "worker-spiderpool", "worker-foundry", "app-site", "gateway", "mcp"]
  }
}

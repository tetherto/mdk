{
  "name": "@tetherto/mdk-mvp-site",
  "version": "0.10.0",
  "description": "MDK MVP Site",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm run setup:config && npm --prefix ../.. run setup && npm --prefix ../.. run build:ui && npm --prefix ../.. install && npm --prefix ui install && npm --prefix ui run build",
    "setup:example": "npm run setup:config && npm install && npm --prefix ../.. run setup:ui && npm --prefix ../.. run build:ui && npm --prefix ui install && npm --prefix ui run build",
    "setup:config": "node deploy/setup-config.js",
    "build:ui": "npm --prefix ui run build",
    "dev:ui": "VITE_API_PORT=3000 npm --prefix ui run dev",
    "start": "node start.js",
    "stop:pm2": "pm2 delete deploy/ecosystem.config.js",
    "lint": "standard",
    "test:unit": "NODE_ENV=test brittle tests/unit/*.test.js",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@tetherto/mdk-core": "^0.10.0",
    "@tetherto/mdk-worker": "^0.10.0",
    "@tetherto/mdk-worker-ocean": "^0.10.0",
    "@tetherto/mdk-worker-satec": "^0.10.0",
    "mdk-crypto-lib": "file:../../backend/lib/mdk-crypto-lib",
    "whatsminer-mdk-worker": "git+https://github.com/whatsminer/whatsminer-mdk-worker.git"
  },
  "overrides": {
    "crypto-js": "file:../../backend/lib/mdk-crypto-lib"
  },
  "devDependencies": {
    "brittle": "3.18.0",
    "standard": "17.1.0"
  }
}

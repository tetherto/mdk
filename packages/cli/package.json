{
  "name": "@tetherto/mdk-cli",
  "version": "0.10.0",
  "description": "MDK command-line tool: onboard, scaffold, run and inspect an MDK stack. Commands marked (stub) are wired up but not implemented yet.",
  "type": "module",
  "bin": {
    "mdk": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@tetherto/mdk-client": "*",
    "@tetherto/mdk-core": "*",
    "@tetherto/mdk-mcp": "*",
    "@tetherto/mdk-skill": "*",
    "@tetherto/mdk-worker": "*",
    "commander": "^15.0.0",
    "degit": "^3.6.6",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

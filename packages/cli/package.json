{
  "name": "@tetherto/mdk-cli",
  "version": "0.13.0",
  "description": "MDK command-line tool: onboard, scaffold, run and inspect an MDK stack.",
  "type": "module",
  "bin": {
    "mdk": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:stack": "vitest run --config vitest.e2e.config.ts tests/e2e/stack.e2e.ts tests/e2e/split.e2e.ts",
    "test:e2e:scaffold": "vitest run --config vitest.e2e.config.ts tests/e2e/scaffold.e2e.ts",
    "prepack": "npm run clean && npm run build"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@tetherto/mdk-app-runtime": "^0.13.0",
    "@tetherto/mdk-client": "^0.13.0",
    "@tetherto/mdk-core": "^0.13.0",
    "@tetherto/mdk-gateway": "^0.13.0",
    "@tetherto/mdk-identity": "^0.13.0",
    "@tetherto/mdk-mcp": "^0.13.0",
    "@tetherto/mdk-rbac": "^0.13.0",
    "@tetherto/mdk-skill": "^0.13.0",
    "@tetherto/mdk-worker": "^0.13.0",
    "commander": "^15.0.0",
    "degit": "^3.6.6",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.12",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/mdk.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}

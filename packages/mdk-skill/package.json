{
  "name": "@tetherto/mdk-skill",
  "version": "0.10.0",
  "description": "MDK Developer Skill Suite — Agent Skills (SKILL.md) bundle assembled from the MDK monorepo's real artifacts and versioned to track the MDK release line. Copy-only assembler: each library owns its artifacts, this package curates them into dist/skills/ and installs them flat into .cursor/skills/ or .claude/skills/.",
  "keywords": [
    "tether",
    "mdk",
    "agent-skills"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "assemble": "node src/assemble.mjs",
    "compile:envelope": "node src/skills/mdk-site-sizing/scripts/compile-envelope.mjs",
    "test": "node src/skills/mdk-site-sizing/scripts/compile-envelope.mjs && node --test tests/site-sizing.test.mjs && node src/skills/mdk-site-sizing/scripts/eval-held-out.mjs",
    "install:skills": "node src/assemble.mjs && node src/install.mjs",
    "prepack": "node src/assemble.mjs"
  }
}

{"name":"Button","path":"src/primitives/components/button/index.tsx","description":"Primary action button. Supports loading state with spinner, icon placement, variants, sizes, and full-width layout. Forwards refs and all native button attributes","tier":"agent-ready","public":true,"category":"actions","domainContext":"generic","props":[{"name":"loading","type":"boolean","required":false,"default":"false","description":"Show a spinner instead of the content and disable the button"},{"name":"fullWidth","type":"boolean","required":false,"default":"false","description":"Make the button stretch to fill its container"},{"name":"icon","type":"React.ReactNode","required":false,"description":"Icon node rendered alongside `children`"},{"name":"variant","type":"\"icon\" | \"link\" | \"primary\" | \"danger\" | \"secondary\" | \"tertiary\" | \"nav-link\" | \"outline\" | \"ghost\"","required":false,"default":"\"secondary\"","description":"Visual variant (e.g. `primary`, `secondary`, `ghost`)"},{"name":"contentClassName","type":"string","required":false,"description":"Class names applied to the inner content wrapper"},{"name":"iconPosition","type":"\"left\" | \"right\"","required":false,"default":"\"left\"","description":"Icon placement relative to children"},{"name":"size","type":"\"sm\" | \"md\" | \"lg\"","required":false,"description":"Size token (`sm`, `md`, `lg`)"},{"name":"disabled","type":"boolean","required":false,"default":"false","description":"Disable the button"},{"name":"type","type":"\"button\" | \"submit\" | \"reset\"","required":false,"default":"\"button\"","description":"Native button type"}],"examples":["src/primitives/components/button/button.example.tsx"],"usageDoc":"src/primitives/components/button/USAGE.md"}

{
  "name": "@tetherto/mdk-ui-foundation",
  "type": "module",
  "version": "0.12.0",
  "private": false,
  "description": "Framework-agnostic headless foundation for the MDK Devkit. Currently exposes Zustand vanilla stores and a TanStack QueryClient factory. No React.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js",
      "default": "./dist/store/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.js",
      "default": "./dist/query/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./app-shared-modules": {
      "types": "./dist/apps/shared-modules.d.ts",
      "import": "./dist/apps/shared-modules.js",
      "default": "./dist/apps/shared-modules.js"
    },
    "./app-ui-paths": {
      "types": "./dist/apps/ui-paths.d.ts",
      "import": "./dist/apps/ui-paths.js",
      "default": "./dist/apps/ui-paths.js"
    },
    "./stores.json": "./dist/stores.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/mdk.git",
    "directory": "ui/packages/ui-foundation"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/specs"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:stores",
    "prepublishOnly": "npm run build",
    "build:ts": "rimraf dist tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json",
    "build:stores": "tsx scripts/generate-stores.mts",
    "clean": "rimraf dist node_modules .turbo",
    "dev": "tsc --watch -p tsconfig.build.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxlint --fix",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --config vitest.config.js --coverage",
    "typecheck": "tsc --noEmit",
    "watch": "npm run dev",
    "watch:ts": "npm run dev"
  },
  "dependencies": {
    "@tanstack/query-core": "^5.59.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
    "ts-morph": "^24.0.0",
    "tsx": "^4.19.2",
    "vitest": "^4.1.2"
  }
}
